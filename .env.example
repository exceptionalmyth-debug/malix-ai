# MAILX AI Environment Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gemini API Intelligence Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Google OAuth 2.0 Credentials (for Gmail API)
# Obtain these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Security
# 32-character hex or string used for AES-256 token encryption
ENCRYPTION_KEY=mailx_ai_super_secret_encryption_key_32bytes!
SESSION_SECRET=mailx_ai_session_secret_key_change_in_prod

# Autonomous Agent Safety Guardrails
MAX_EMAILS_PER_HOUR=25
AUTO_SEND_DEFAULT=false
